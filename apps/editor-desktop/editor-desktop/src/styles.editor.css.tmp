:root{--teal900:#034f5a;--teal700:#087c8b;--teal050:#f3fbfc;--line:#c9dbe2;--bg:#edf4f7;--text:#142033}
*{box-sizing:border-box} body{margin:0;font-family:"Segoe UI",Tahoma,Arial,sans-serif;color:var(--text);background:#cfd9e5}.app-shell{height:100vh;display:flex;flex-direction:column;background:var(--bg)}.titlebar{height:48px;background:linear-gradient(90deg,var(--teal900),var(--teal700));display:flex;align-items:center;color:#fff;padding:0 16px;gap:14px}.brand{display:flex;align-items:center;gap:10px;font-size:20px}.brand span:last-child{font-size:14px;opacity:.9}.logo{width:28px;height:28px;border-radius:50%;background:#fff;color:var(--teal700);display:grid;place-items:center}.title-chip{margin-left:auto;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:14px;padding:5px 12px;font-size:12px}.title-chip+.title-chip{margin-left:0}.menu-bar{height:42px;background:#fff;border-bottom:1px solid var(--line);display:flex}.menu-bar button{min-width:112px;border:0;border-right:1px solid #e2edf1;background:#fff;font-weight:700;cursor:pointer}.menu-bar button.active{background:var(--teal700);color:#fff}.ribbon{height:92px;background:linear-gradient(#fff,#edf6f8);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:8px 12px}.tool{height:68px;min-width:72px;border:1px solid transparent;background:transparent;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:11px;cursor:pointer}.tool span{font-size:22px}.tool:hover,.tool.primary{background:#e7f8fb;border-color:#9ed4dd;color:var(--teal900)}.workspace{flex:1;min-height:0;display:grid;grid-template-columns:280px 1fr 300px}.left-panel,.right-panel{background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column}.right-panel{border-right:0;border-left:1px solid var(--line)}.panel-title{height:42px;background:#f4fbfc;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 14px;font-weight:800;color:var(--teal900)}.panel-list{padding:12px}.node{padding:8px 10px;border-radius:6px;margin-bottom:4px}.node.active{background:var(--teal700);color:#fff}.main-area{overflow:auto;padding:14px}.page,.designer,.report-page{background:#fff;border:1px solid var(--line);border-radius:10px;min-height:540px;padding:24px}.page h1,.report-page h1{margin:0 0 10px;color:var(--teal900)}.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.card{border:1px solid var(--line);border-radius:10px;padding:18px;background:#fff;display:flex;flex-direction:column;gap:6px}table{width:100%;border-collapse:collapse;margin-top:16px}th,td{border-bottom:1px solid #e1edf1;text-align:left;padding:10px}th{background:#edf6f8;color:#64748b;text-transform:uppercase;font-size:11px}.designer{padding:0}.canvas{position:relative;min-height:560px;padding:24px;background:#fbfdff;background-image:linear-gradient(#e4edf2 1px,transparent 1px),linear-gradient(90deg,#e4edf2 1px,transparent 1px);background-size:20px 20px}.obj{position:absolute;background:#fff;border:1px solid #9fc4cc;border-radius:8px;padding:14px;box-shadow:0 4px 10px rgba(0,0,0,.06)}.obj.power{top:90px;left:60px}.obj.gauge{top:210px;left:80px}.obj.line{top:120px;left:350px;width:360px;height:160px}.props{padding:14px}.props label{display:block;font-size:12px;margin-bottom:12px}.props input{width:100%;padding:7px;border:1px solid var(--line);border-radius:6px;margin-top:4px}.statusbar{height:34px;background:linear-gradient(90deg,var(--teal900),var(--teal700));color:#fff;display:flex;align-items:center;gap:22px;padding:0 16px;font-size:12px}.statusbar .right{margin-left:auto}

/* Phase 2 - Project + SQLite + Prisma */
.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:14px}.page-header h1{margin:0 0 4px;color:#034f5a}.phase-badge{background:#087c8b;color:white;border-radius:999px;padding:7px 12px;font-weight:800;font-size:12px}.alert{border-radius:8px;padding:10px 12px;margin-bottom:12px;font-weight:700}.alert.success{background:#e8f7ee;color:#146c2e;border:1px solid #b8e6c6}.alert.error{background:#fdeceb;color:#991b1b;border:1px solid #f4b6b6}.project-grid{display:grid;grid-template-columns:minmax(560px,1.4fr) minmax(300px,.7fr);gap:14px;margin-bottom:14px}.large-card{min-height:260px}.card-title{font-weight:800;color:#034f5a;margin-bottom:12px;font-size:16px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid label,.props label{display:flex;flex-direction:column;gap:5px;color:#475569;font-weight:700}.form-grid input,.props input{border:1px solid #c9dbe2;border-radius:6px;padding:9px;background:#fff;color:#142033}.button-row{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}.btn{border:0;border-radius:7px;padding:8px 13px;font-weight:800;cursor:pointer}.btn.primary{background:#087c8b;color:#fff}.btn.secondary{background:#fff;border:1px solid #c9dbe2;color:#142033}.btn.danger{background:#d93025;color:#fff}.btn.tiny{font-size:12px;padding:5px 8px;background:#087c8b;color:#fff}.kv{display:flex;justify-content:space-between;border-bottom:1px solid #e5eef2;padding:9px 0}.path-box{margin-top:12px;border:1px dashed #9fc4cc;border-radius:8px;background:#f8fcfd;padding:10px;word-break:break-all;color:#475569;font-family:Consolas,monospace;font-size:12px}.project-list-card{overflow:auto}.project-table{width:100%;border-collapse:collapse}.project-table th,.project-table td{border-bottom:1px solid #e1edf1;padding:9px 10px;text-align:left}.project-table th{background:#edf6f8;color:#556674;text-transform:uppercase;font-size:11px}.active-row td{background:#e5f7fa}.pill{display:inline-block;background:#dbeafe;color:#1d4ed8;border-radius:999px;padding:2px 8px;font-size:11px;font-weight:800}.table-actions{display:flex;gap:6px}

/* Phase 3 - Devices */
.devices-page{padding:20px}.device-summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}.meter-kpi{border:1px solid var(--line);border-radius:10px;background:#fff;padding:14px;display:flex;flex-direction:column;gap:8px}.meter-kpi span{color:#64748b;font-weight:800}.meter-kpi b{font-size:28px;color:#087c8b}.devices-layout{display:grid;grid-template-columns:330px 1fr;gap:14px;margin-bottom:14px}.device-tree-card,.device-form-card{min-height:410px}.device-tree-row{width:100%;min-height:32px;border:0;background:transparent;display:flex;align-items:center;gap:8px;text-align:left;border-radius:7px;cursor:pointer;color:#142033}.device-tree-row:hover{background:#edf7f9}.device-tree-row.selected{background:#087c8b;color:#fff}.status-dot{width:9px;height:9px;border-radius:50%;margin-left:auto;background:#94a3b8}.status-dot.online{background:#16a34a}.status-dot.offline{background:#dc2626}.status-dot.warning{background:#f59e0b}.status-dot.unknown{background:#94a3b8}.muted{color:#64748b}.left-align{justify-content:flex-start}.mode-tabs{display:flex;gap:8px;margin-bottom:14px}.mode-tabs button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:8px 12px;font-weight:800;cursor:pointer}.mode-tabs button.active{background:#087c8b;color:#fff;border-color:#087c8b}.device-form-grid{grid-template-columns:repeat(3,minmax(180px,1fr))}.form-grid select{border:1px solid #c9dbe2;border-radius:6px;padding:9px;background:#fff;color:#142033}.checkbox-row{display:flex;gap:18px;margin-top:14px;color:#475569;font-weight:800}.selected-device-card{margin-bottom:14px}.selected-device-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px 20px}.status-text.online{color:#16a34a}.status-text.offline{color:#dc2626}.status-text.warning{color:#d97706}.status-text.unknown{color:#64748b}.device-pill{border-radius:999px;padding:3px 9px;font-size:11px;font-weight:800}.device-pill.online{background:#dcfce7;color:#166534}.device-pill.offline{background:#fee2e2;color:#991b1b}.device-pill.warning{background:#fff7ed;color:#c2410c}.device-pill.unknown{background:#e2e8f0;color:#475569}.device-list-card{overflow:auto}.btn:disabled{opacity:.5;cursor:not-allowed}

/* Phase 4 - Tags */
.phase4-summary-grid{grid-template-columns:repeat(4,1fr)}
.tag-form-card{margin-bottom:14px}
.tag-form-grid{grid-template-columns:repeat(4,minmax(170px,1fr))}
.device-pill.good{background:#dcfce7;color:#166534}
.device-pill.bad{background:#fee2e2;color:#991b1b}
.device-pill.uncertain{background:#fff7ed;color:#c2410c}
.device-pill.unknown{background:#e2e8f0;color:#475569}
@media(max-width:1200px){.tag-form-grid{grid-template-columns:repeat(2,1fr)}.phase4-summary-grid{grid-template-columns:repeat(2,1fr)}}

/* Phase 8 - Graphics Designer */
.graphics-page{padding:20px}.graphics-layout{display:grid;grid-template-columns:260px minmax(520px,1fr) 320px;gap:14px}.graphics-toolbox,.graphics-designer-card,.graphics-properties{min-height:640px}.new-graphic-box{display:flex;flex-direction:column;gap:10px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #e5eef2}.new-graphic-box label,.graphics-properties label{display:flex;flex-direction:column;gap:5px;font-weight:800;color:#475569;margin-bottom:10px}.new-graphic-box input,.graphics-properties input,.graphics-properties select{border:1px solid #c9dbe2;border-radius:6px;padding:8px;background:#fff;color:#142033}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:8px}.graphic-list{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}.graphic-list-item{border:1px solid #c9dbe2;background:#fff;border-radius:8px;text-align:left;padding:10px;display:flex;flex-direction:column;gap:4px;cursor:pointer;color:#142033}.graphic-list-item:hover,.graphic-list-item.selected{border-color:#087c8b;background:#e7f8fb}.graphic-list-item span{font-size:12px;color:#64748b}.graphic-list-item em{font-style:normal;font-size:11px;color:#166534;background:#dcfce7;border-radius:999px;padding:2px 8px;width:max-content}.tool-section-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a9aaa;font-weight:900;margin:14px 0 8px}.object-tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.object-tool{min-height:66px;border:1px solid #c9dbe2;border-radius:8px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-weight:800;cursor:pointer}.object-tool span{font-size:22px}.object-tool:hover:not(:disabled){border-color:#087c8b;background:#e7f8fb;color:#034f5a}.object-tool:disabled{opacity:.45;cursor:not-allowed}.designer-toolbar{height:54px;border-bottom:1px solid #e5eef2;background:#f8fcfd;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 12px}.button-row.compact{margin:0;display:flex;gap:7px}.graphic-canvas-scroll{height:584px;overflow:auto;background:#e9eef3;padding:18px}.graphic-canvas{position:relative;background-image:linear-gradient(#e4edf2 1px,transparent 1px),linear-gradient(90deg,#e4edf2 1px,transparent 1px);background-size:20px 20px;border:1px solid #cbd5e1;box-shadow:0 4px 14px rgba(20,32,51,.08);transform-origin:top left}.empty-canvas,.empty-designer{display:grid;place-items:center;min-height:380px;color:#64748b;font-weight:800;border:1px dashed #9fc4cc;border-radius:8px;background:rgba(255,255,255,.65)}.empty-canvas{position:absolute;inset:28px}.graphic-object{position:absolute;border:1px solid #9fc4cc;border-radius:8px;background:#fff;box-shadow:0 4px 10px rgba(0,0,0,.05);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;overflow:hidden;color:#142033;padding:8px;text-align:center}.graphic-object:hover,.graphic-object.selected{outline:2px solid #087c8b;outline-offset:2px}.graphic-object-line{height:18px!important;border-radius:0;border-width:0;border-top:4px solid #334155;background:transparent;box-shadow:none}.graphic-object-rectangle{background:rgba(255,255,255,.75)}.graphic-object-gauge::before{content:"";width:80px;height:42px;border:10px solid #bfe6ed;border-bottom:0;border-radius:80px 80px 0 0}.graphic-object-trend::before{content:"";display:block;width:80%;height:36px;border-left:2px solid #087c8b;border-bottom:2px solid #087c8b;background:linear-gradient(180deg,#e5f7fa,transparent)}.object-title{font-size:11px;font-weight:900;color:#034f5a}.object-text{font-size:13px;font-weight:800}.object-binding{font-size:11px;color:#1d4ed8;background:#dbeafe;border-radius:999px;padding:2px 7px}.prop-section{border-bottom:1px solid #e5eef2;padding:0 0 12px;margin-bottom:12px}.prop-title{font-weight:900;color:#034f5a;margin-bottom:10px}.graphics-properties .card-title,.graphics-toolbox .card-title{font-size:16px;color:#034f5a;margin-bottom:12px}@media(max-width:1300px){.graphics-layout{grid-template-columns:220px 1fr}.graphics-properties{grid-column:1 / -1}.graphic-canvas-scroll{height:520px}}

/* Phase 10 - Reports Designer */
.report-designer-shell {
  display: grid;
  grid-template-columns: 220px 1fr;
  min-height: 620px;
  border: 1px solid var(--line, #c9dbe2);
  background: #f5f8fb;
  border-radius: 10px;
  overflow: hidden;
}

.designer-tools.in-workspace {
  background: #f8fcfd;
  border-right: 1px solid var(--line, #c9dbe2);
  overflow: auto;
}

.report-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.report-toolbar-line {
  height: 44px;
  border-bottom: 1px solid var(--line, #c9dbe2);
  background: #fff;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
}

.report-toolbar-line span {
  margin-left: auto;
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

.report-layout {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 220px 1fr 260px;
}

.report-list-panel,
.report-props-panel {
  background: #fff;
  border-right: 1px solid var(--line, #c9dbe2);
  padding: 12px;
  overflow: auto;
}

.report-props-panel {
  border-right: 0;
  border-left: 1px solid var(--line, #c9dbe2);
}

.report-list-item {
  width: 100%;
  display: block;
  text-align: left;
  padding: 10px 12px;
  border: 1px solid #d9e8ee;
  background: #fff;
  border-radius: 8px;
  margin-bottom: 8px;
  cursor: pointer;
  font-weight: 700;
}

.report-list-item small {
  display: block;
  font-weight: 500;
  color: #64748b;
  margin-top: 4px;
}

.report-list-item.active {
  border-color: #087c8b;
  background: #e5f7fa;
  color: #034f5a;
}

.report-page-wrap {
  overflow: auto;
  padding: 24px;
  background: #e9eef3;
}

.report-page-canvas {
  position: relative;
  margin: 0 auto;
  box-shadow: 0 12px 35px rgba(15, 23, 42, .16);
  border: 1px solid #cbd5e1;
  overflow: hidden;
}

.report-object {
  position: absolute;
  border: 1px solid #9fc4cc;
  background: #fff;
  border-radius: 6px;
  padding: 8px;
  cursor: pointer;
  text-align: left;
  color: #142033;
  overflow: hidden;
}

.report-object.selected {
  outline: 2px solid #087c8b;
  outline-offset: 2px;
}

.report-object.table,
.report-object.alarm_table {
  background: repeating-linear-gradient(#fff, #fff 30px, #eef7f9 31px);
}

.report-object.graph {
  background: linear-gradient(#fff, #eef7f9);
}

.report-object span {
  display: block;
  margin-top: 6px;
  color: #64748b;
  font-size: 12px;
}

.report-props-panel label,
.object-props label {
  display: block;
  margin-bottom: 10px;
  color: #475569;
  font-size: 12px;
}

.report-props-panel input,
.report-props-panel select,
.object-props input,
.object-props select {
  width: 100%;
  border: 1px solid #cadce2;
  border-radius: 6px;
  padding: 7px;
  background: #fff;
  margin-top: 4px;
}

.error-box {
  margin: 10px;
  background: #fee2e2;
  color: #991b1b;
  border: 1px solid #fecaca;
  border-radius: 8px;
  padding: 10px;
}

.access-page,
.access-denied-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #d9edf2, #f3fbfc);
  color: #142033;
}

.access-card,
.access-denied-card {
  width: min(560px, calc(100vw - 32px));
  background: #fff;
  border: 1px solid #c9dbe2;
  border-radius: 18px;
  padding: 26px;
  box-shadow: 0 18px 48px rgba(16, 44, 56, .18);
}

.access-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.access-logo {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #087c8b;
  color: #fff;
  font-size: 26px;
}

.access-brand h1,
.access-denied-card h1 { margin: 0 0 4px; color: #034f5a; }
.access-brand p { margin: 0; color: #64748b; }
.access-form { display: grid; gap: 12px; margin-top: 18px; }
.access-form h2 { margin: 0; color: #034f5a; }
.access-form label,
.access-field { display: grid; gap: 5px; color: #475569; font-weight: 600; }
.access-form input,
.access-field input { border: 1px solid #cadce2; border-radius: 8px; padding: 10px; font: inherit; }
.access-inline { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
.access-inline button,
.access-primary,
.access-denied-card button,
.exit-button { border: 0; border-radius: 8px; background: #087c8b; color: #fff; padding: 10px 14px; font-weight: 800; cursor: pointer; }
.access-message { margin-top: 14px; border-radius: 8px; padding: 10px; background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; }
.access-message.ok { background: #dcfce7; border-color: #86efac; color: #166534; }
.exit-button { margin-left: 8px; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.3); }
.notice { margin-top: 14px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1e40af; padding: 10px; border-radius: 8px; }


/* Phase 21: Access Control and Operation Log */
.page-header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 14px; }
.page-header-row h1, .page-header-row h2 { margin: 0 0 6px; color: #034f5a; }
.page-header-row p { margin: 0; color: #64748b; }
.page-header-row.tight { align-items: center; margin-bottom: 10px; }
.access-admin-grid { display: grid; grid-template-columns: 1.6fr .9fr; gap: 14px; margin-bottom: 14px; }
.panel-card { background: #fff; border: 1px solid #c9dbe2; border-radius: 12px; padding: 14px; margin-bottom: 14px; box-shadow: 0 4px 14px rgba(16,44,56,.05); }
.panel-card h2 { margin: 0 0 12px; color: #034f5a; }
.data-table.compact th, .data-table.compact td { padding: 8px 9px; font-size: 12px; }
.data-table.compact td span { color: #64748b; font-size: 11px; }
.selected-row td { background: #e5f7fa !important; }
.form-grid { display: grid; gap: 10px; }
.form-grid.one-col { grid-template-columns: 1fr; }
.form-grid label, .secret-reset-row label { display: grid; gap: 4px; color: #475569; font-weight: 600; }
.form-grid input, .form-grid select, .secret-reset-row input, .inline-actions select { border: 1px solid #cadce2; border-radius: 7px; padding: 8px; font: inherit; background: #fff; }
.inline-actions { display: flex; gap: 8px; align-items: center; }
.secret-reset-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: end; max-width: 560px; }
.notice.ok { background: #dcfce7; border-color: #86efac; color: #166534; }
.btn { border: 0; border-radius: 8px; background: #087c8b; color: #fff; padding: 9px 13px; font-weight: 800; cursor: pointer; }
.btn.secondary { background: #fff; color: #123; border: 1px solid #c9dbe2; }
.btn:disabled { opacity: .55; cursor: not-allowed; }
@media(max-width: 1200px){ .access-admin-grid { grid-template-columns: 1fr; } .secret-reset-row { grid-template-columns: 1fr; } }

/* Phase 25 - System Settings / Runtime Configuration UI */
.setup-tabs {
  display: flex;
  gap: 8px;
  margin: 14px 0 18px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 8px;
}
.setup-tabs button {
  border: 1px solid var(--line);
  background: #fff;
  color: var(--ink);
  border-radius: 8px;
  padding: 9px 14px;
  font-weight: 700;
  cursor: pointer;
}
.setup-tabs button.active {
  background: var(--teal-700);
  color: #fff;
  border-color: var(--teal-700);
}
.runtime-settings-grid {
  display: grid;
  grid-template-columns: 1.4fr .8fr;
  gap: 14px;
}
.runtime-settings-grid .span-2 { grid-column: span 1; }
.runtime-settings-grid .span-3 { grid-column: 1 / -1; }
.settings-section-title {
  margin: 18px 0 10px;
  padding-top: 10px;
  border-top: 1px solid #e2edf1;
  color: var(--teal-800);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
  font-size: 11px;
}
.form-grid.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.form-grid.one-col {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}
.form-grid label,
.secret-reset-row label {
  display: flex;
  flex-direction: column;
  gap: 5px;
  color: #475569;
  font-size: 12px;
  font-weight: 700;
}
.form-grid input,
.form-grid select,
.secret-reset-row input,
.inline-actions select {
  border: 1px solid var(--line);
  border-radius: 7px;
  padding: 8px 10px;
  min-height: 35px;
  background: #fff;
  color: var(--ink);
}
.form-grid input:disabled,
.form-grid select:disabled {
  background: #f4f7f9;
  color: #6b7c8c;
}
.toggle-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 8px 12px;
  margin-top: 12px;
}
.toggle-row {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #d8e8ee;
  border-radius: 8px;
  padding: 9px 10px;
  background: #fbfeff;
  font-weight: 700;
}
.settings-list {
  margin: 8px 0 14px 18px;
  padding: 0;
  color: #475569;
}
.notice.warn {
  background: #fff7ed;
  border-color: #fed7aa;
  color: #9a3412;
}
.notice.ok {
  background: #ecfdf5;
  border-color: #bbf7d0;
  color: #166534;
}
.panel-card code {
  display: block;
  overflow-wrap: anywhere;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 8px;
  border-radius: 6px;
  color: #334155;
}
@media (max-width: 1200px) {
  .runtime-settings-grid,
  .form-grid.two-col,
  .toggle-grid {
    grid-template-columns: 1fr;
  }
}

.scheduler-panel{margin:12px 0;padding:14px;border:1px solid #c9dbe2;border-radius:10px;background:#f8fcfd}
.scheduler-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.scheduler-head span{display:block;color:#64748b;font-size:12px;margin-top:3px}
.scheduler-create-row{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}
.scheduler-create-row select,.scheduler-create-row input{height:34px;border:1px solid #c9dbe2;border-radius:6px;padding:0 8px;background:#fff}
.data-table.compact td,.data-table.compact th{padding:6px 8px;font-size:12px}
.object-tool.selected{border-color:#087c8b;background:#dff8fb;color:#034f5a;box-shadow:0 0 0 2px rgba(8,124,139,.12)}
.graphics-properties input[type="checkbox"]{width:auto;margin-right:6px}.graphics-properties input[type="color"]{height:36px;padding:2px}.graphic-object{user-select:none}.graphic-object[title*="Locked"]{cursor:not-allowed}.designer-toolbar .btn{white-space:nowrap}

/* Blueprint alignment pass: compact desktop ribbon editor shell */
:root {
  --teal-900: #034f5a;
  --teal-800: #056473;
  --teal-700: #087c8b;
  --teal-100: #e5f7fa;
  --teal-050: #f3fbfc;
  --ink: #142033;
  --muted: #64748b;
  --canvas: #f5f8fb;
  --panel: #fff;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-size: 13px;
}

body {
  background: #cfd9e5;
  color: var(--ink);
}

.app-shell {
  min-width: 1180px;
  height: 100vh;
  background: var(--teal-050);
  border: 1px solid #9fc4cc;
  overflow: hidden;
}

.titlebar {
  height: 46px;
  min-height: 46px;
  padding: 0 14px;
  gap: 14px;
}

.brand {
  min-width: 360px;
  font-size: 21px;
  letter-spacing: 0;
}

.brand .logo {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 12px;
  font-weight: 900;
  background: #fff;
  color: var(--teal-700);
}

.brand span:last-child {
  font-size: 13px;
  font-weight: 500;
  opacity: .92;
}

.title-spacer {
  flex: 1;
}

.title-chip {
  margin-left: 0;
  height: 26px;
  display: inline-flex;
  align-items: center;
  border-radius: 14px;
  padding: 0 12px;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
}

.window-controls {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 13px;
  font-weight: 700;
  opacity: .9;
}

.menu-bar {
  height: 42px;
  min-height: 42px;
}

.menu-bar button {
  min-width: 112px;
  height: 42px;
  padding: 0 16px;
  font-size: 14px;
  font-weight: 700;
  color: #0f2730;
}

.menu-bar button:hover:not(.active) {
  background: #eaf6f8;
}

.ribbon {
  height: 96px;
  min-height: 96px;
  align-items: stretch;
  gap: 10px;
  padding: 8px 12px;
  overflow: hidden;
}

.ribbon-group {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 12px 14px 0;
  border-right: 1px solid var(--line);
}

.ribbon-group:last-child {
  border-right: 0;
}

.ribbon-tools {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ribbon-label {
  position: absolute;
  right: 12px;
  bottom: 0;
  left: 0;
  color: var(--muted);
  text-align: center;
  font-size: 10px;
  line-height: 12px;
}

.tool {
  width: 68px;
  min-width: 68px;
  height: 70px;
  padding: 5px 4px;
  border-radius: 8px;
  gap: 4px;
  font-size: 11px;
  line-height: 1.1;
  color: #1e2c3a;
}

.tool.wide {
  width: 92px;
  min-width: 92px;
}

.tool .tool-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 26px;
  font-size: 12px;
  font-weight: 900;
  line-height: 1;
}

.tool .tool-text {
  display: block;
  max-width: 100%;
  text-align: center;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.1;
  white-space: normal;
  overflow-wrap: anywhere;
}

.tool:hover,
.tool.primary {
  background: #e7f8fb;
  border-color: #9ed4dd;
  color: var(--teal-800);
}

.workspace {
  grid-template-columns: 300px minmax(0, 1fr) 320px;
  min-height: 0;
  background: var(--canvas);
}

.app-shell.designer-mode .workspace {
  grid-template-columns: 240px minmax(0, 1fr) 320px;
}

.left-panel,
.right-panel {
  background: var(--panel);
  overflow: hidden;
}

.panel-title {
  height: 42px;
  min-height: 42px;
  justify-content: space-between;
  padding: 0 14px;
  background: #f4fbfc;
  font-size: 13px;
  font-weight: 800;
}

.panel-action {
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
}

.panel-list {
  flex: 1;
  overflow: auto;
  padding: 12px;
}

.tool-panel-list {
  padding: 0;
  background: #f8fcfd;
}

.left-tool-section {
  padding: 10px;
  border-bottom: 1px solid #d8e8ee;
}

.left-tree-list {
  display: grid;
  gap: 5px;
}

.left-tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.left-tool {
  min-height: 34px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 8px;
  text-align: left;
}

.left-tool-grid .left-tool {
  min-height: 76px;
  border: 1px solid #c9dbe2;
  border-radius: 8px;
  background: #fff;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(20, 32, 51, .03);
}

.left-tool span {
  font-size: 11px;
  font-weight: 900;
  color: var(--teal-800);
}

.left-tool b {
  font-size: 12px;
  line-height: 1.15;
}

.left-tool:hover,
.left-tool.active {
  background: #e7f8fb;
  color: var(--teal-800);
}

.left-tool-grid .left-tool:hover,
.left-tool-grid .left-tool.active {
  border-color: var(--teal-700);
}

.main-area {
  min-width: 0;
  overflow: auto;
  padding: 14px;
}

.page,
.designer,
.report-page,
.card,
.panel-card,
.setup-card {
  border-radius: 8px;
}

.page,
.designer,
.report-page {
  min-height: calc(100vh - 260px);
  padding: 18px;
}

.page-header,
.page-header-row {
  margin-bottom: 12px;
}

.page-header h1,
.page-header-row h1,
.page-header-row h2 {
  font-size: 22px;
  line-height: 1.18;
}

.page-header p,
.page-header-row p,
.muted {
  font-size: 12px;
  line-height: 1.35;
}

.card {
  padding: 14px;
  box-shadow: none;
}

.card-title {
  margin-bottom: 10px;
  font-size: 15px;
}

.form-grid,
.device-form-grid,
.tag-form-grid {
  gap: 10px;
}

.form-grid label,
.props label,
.new-graphic-box label,
.graphics-properties label,
.report-props-panel label,
.object-props label {
  font-size: 12px;
  font-weight: 700;
}

.form-grid input,
.form-grid select,
.props input,
.new-graphic-box input,
.graphics-properties input,
.graphics-properties select,
.report-props-panel input,
.report-props-panel select,
.object-props input,
.object-props select {
  min-height: 32px;
  padding: 7px 8px;
  font-size: 12px;
  border-radius: 6px;
}

.btn {
  min-height: 32px;
  padding: 7px 12px;
  border-radius: 7px;
  font-size: 12px;
  line-height: 1.15;
  white-space: nowrap;
}

.btn.tiny {
  min-height: 26px;
  padding: 5px 8px;
}

th,
td {
  padding: 8px 9px;
  font-size: 12px;
}

th {
  font-size: 10px;
  letter-spacing: .04em;
}

.meter-kpi {
  border-radius: 8px;
  padding: 12px;
}

.meter-kpi b,
.meter-kpi .v {
  font-size: 23px;
}

.props {
  overflow: auto;
  padding: 12px;
}

.props .prop-section {
  padding: 0 0 12px;
  margin-bottom: 12px;
}

.props label {
  margin-bottom: 9px;
}

.props .prop-row {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
}

.pill.online {
  background: #dcfce7;
  color: #166534;
}

.statusbar {
  height: 34px;
  min-height: 34px;
  gap: 26px;
  padding: 0 16px;
  font-size: 12px;
}

.statusbar span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

.dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #22c55e;
}

.dot.red {
  background: #ef4444;
}

.graphics-page,
.devices-page {
  padding: 0;
}

.graphics-layout {
  grid-template-columns: 250px minmax(520px, 1fr) 300px;
  gap: 12px;
}

.graphics-toolbox,
.graphics-designer-card,
.graphics-properties {
  min-height: 600px;
}

.graphic-canvas-scroll {
  height: 544px;
  padding: 14px;
}

.report-designer-shell {
  min-height: 600px;
  border-radius: 8px;
}

.report-layout {
  grid-template-columns: 210px minmax(420px, 1fr) 250px;
}

.report-page-wrap {
  padding: 18px;
}

@media (max-width: 1300px) {
  .workspace,
  .app-shell.designer-mode .workspace {
    grid-template-columns: 240px minmax(0, 1fr) 280px;
  }

  .tool {
    width: 62px;
    min-width: 62px;
  }

  .tool.wide {
    width: 80px;
    min-width: 80px;
  }
}

/* Blueprint fit pass: keep every editor surface inside the three-panel shell */
:root {
  --blueprint-shadow: 0 14px 34px rgba(16, 44, 56, .16);
}

.app-shell {
  width: 100vw;
  max-width: 100vw;
  min-width: 1180px;
  box-shadow: var(--blueprint-shadow);
}

.titlebar,
.menu-bar,
.ribbon,
.workspace,
.statusbar {
  flex-shrink: 0;
}

.workspace {
  flex: 1 1 auto;
  grid-template-columns: 300px minmax(0, 1fr) 320px;
  overflow: hidden;
}

.main-area,
.page,
.designer,
.report-page,
.card,
.panel-card,
.large-card,
.project-list-card,
.graphics-designer-card,
.graphics-properties,
.device-form-card,
.device-tree-card {
  min-width: 0;
}

.main-area {
  display: block;
  overflow: auto;
  padding: 14px 16px;
}

.page,
.designer,
.report-page {
  width: 100%;
  max-width: 100%;
}

.project-page {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.project-page .page-header,
.project-page .alert,
.project-page .project-grid,
.project-page .project-list-card {
  margin-bottom: 0;
}

.page-header {
  min-width: 0;
}

.page-header > div,
.page-header-row > div {
  min-width: 0;
}

.page-header p,
.page-header-row p {
  overflow-wrap: anywhere;
}

.project-grid {
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
  align-items: stretch;
  gap: 14px;
}

.project-grid > .card {
  overflow: hidden;
}

.large-card {
  min-height: 0;
}

.form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.button-row {
  flex-wrap: wrap;
  align-items: center;
}

.button-row.left-align {
  justify-content: flex-start;
}

.project-grid .button-row.left-align {
  display: grid;
  grid-template-columns: repeat(3, minmax(78px, 1fr));
}

.project-grid .button-row.left-align .btn {
  width: 100%;
}

.path-box {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.project-list-card {
  flex: 1 1 auto;
  min-height: 180px;
  overflow: auto;
}

.project-table {
  min-width: 880px;
}

.table-actions {
  flex-wrap: wrap;
}

.props {
  min-width: 0;
}

.props input {
  min-width: 0;
}

.statusbar {
  overflow: hidden;
}

.statusbar span {
  min-width: 0;
}

@media (max-width: 1500px) {
  .workspace,
  .app-shell.designer-mode .workspace {
    grid-template-columns: 260px minmax(0, 1fr) 300px;
  }

  .project-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 1240px) {
  .workspace,
  .app-shell.designer-mode .workspace {
    grid-template-columns: 230px minmax(0, 1fr) 260px;
  }

  .ribbon {
    overflow-x: auto;
  }

  .form-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
