{
  "name": "@energylink/engine-manager-desktop",
  "version": "0.18.0-phase18",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "package:dir": "electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.8.6",
    "vite": "^6.4.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.9.3",
    "electron-builder": "^26.0.12"
  },
  "description": "EnergyLink Engine Manager Desktop utility for controlling and inspecting the installed Windows service. It does not generate runtime values."
}
